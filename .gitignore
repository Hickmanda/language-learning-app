# ============================================================
# .gitignore — files and folders Git should NOT track
# ============================================================

# Virtual environment (huge, installed locally)
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Flask / SQLAlchemy local database
instance/
*.db
*.sqlite
*.sqlite3

# Flask-Migrate (keep the folder itself, but not the cached pyc)
migrations/versions/*.pyc

# Environment variables (secrets!)
.env
.env.local

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS-generated
.DS_Store
Thumbs.db

# Logs
*.log

# Docker volumes (if any)
postgres_data/